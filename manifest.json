1. Update fetch_matrix_from_drive() (Lines 229–272)
In app (2).py, line 247 was skipping the Sartorial Palettes sheet due to NON_PAIRING_SHEETS.

Replace fetch_matrix_from_drive() with this block so it pulls the 3-option palettes from your Google Sheet while keeping pairing tabs clean:

Python
@st.cache_data(
    ttl=300, show_spinner="Syncing with Fragrance Matrix in Google Drive..."
)
def fetch_matrix_from_drive():
  solo_df = pd.DataFrame(STANDALONE_MASTER)

  if "gcp_service_account" not in st.secrets:
    return pd.concat(
        [get_fallback_dataframe(), solo_df], ignore_index=True
    ), SARTORIAL_MAP

  try:
    creds = Credentials.from_service_account_info(
        st.secrets["gcp_service_account"], scopes=SCOPE
    )
    client = gspread.authorize(creds)
    sheet_name = st.secrets.get("spreadsheet_name", "Fragrance Matrix")
    spreadsheet = client.open(sheet_name)

    all_dfs = []
    drive_sartorial = {}
    for ws in spreadsheet.worksheets():
      ws_title_lower = ws.title.strip().lower()

      # Read 3-option Sartorial Palettes sheet from Google Drive
      if "sartorial" in ws_title_lower:
        s_records = ws.get_all_records()
        for r in s_records:
          p_name = str(
              r.get("Custom Scent Profile Name")
              or r.get("Custom Profile Name")
              or ""
          ).strip()
          base = str(
              r.get("Base Layer / Entity") or r.get("Base Layer") or ""
          ).strip()
          top = str(
              r.get("Top Layer / Partner") or r.get("Top Layer") or ""
          ).strip()

          opts = []
          for opt_idx in [1, 2, 3]:
            o_name = str(r.get(f"Option {opt_idx}: Palette Name") or "").strip()
            o_prim = str(
                r.get(f"Option {opt_idx}: Primary Swatch") or ""
            ).strip()
            o_acc = str(
                r.get(f"Option {opt_idx}: Highlight Swatch") or ""
            ).strip()
            o_sty = str(
                r.get(f"Option {opt_idx}: Styling Context") or ""
            ).strip()
            if o_name and o_prim and o_acc:
              opts.append({
                  "opt_num": opt_idx,
                  "name": o_name,
                  "primary": o_prim,
                  "accent": o_acc,
                  "styling": o_sty,
              })
          if opts:
            if p_name:
              drive_sartorial[p_name] = opts
            if base and top:
              drive_sartorial[f"{base} + {top}"] = opts

      if any(term in ws_title_lower for term in NON_PAIRING_SHEETS):
        continue

      records = ws.get_all_records()
      if records:
        w_df = pd.DataFrame(records)
        w_df["Season_Sheet"] = ws.title
        w_df = clean_matrix_columns(w_df)
        all_dfs.append(w_df)

    full_sartorial = SARTORIAL_MAP.copy()
    full_sartorial.update(drive_sartorial)

    if all_dfs:
      master = pd.concat(all_dfs, ignore_index=True)
      master = master[
          master["Base Layer"].notna()
          & (master["Base Layer"].astype(str).str.strip() != "")
          & (master["Base Layer"].astype(str).str.strip().str.lower() != "nan")
      ]
      master.fillna("", inplace=True)
      combined = pd.concat([master, solo_df], ignore_index=True)
      return combined, full_sartorial

    return pd.concat(
        [get_fallback_dataframe(), solo_df], ignore_index=True
    ), full_sartorial
  except Exception as e:
    st.sidebar.error(f"Google Drive Sync Notice: {e}")
    return pd.concat(
        [get_fallback_dataframe(), solo_df], ignore_index=True
    ), SARTORIAL_MAP
